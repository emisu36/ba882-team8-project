# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
#   cp .env.example .env
#   # edit .env with your values

# Your GCP project ID
GCP_PROJECT=your-gcp-project-id

# GCS bucket where raw artifacts are landed
GCS_BUCKET=your-bucket-name

# AutoElite API — get your key from the course site
AUTOELITE_API_BASE=https://btibert-bu--autoelite-api-fastapi-app.modal.run
AUTOELITE_API_KEY=your-api-key

# Service account key for GCP auth.
# Place sa-key.json at the project root — it is gitignored.
# Use the full path (not ~/) — tilde does not expand reliably in all tools.
# On Astronomer cloud this is set in the deployment UI instead.
GOOGLE_APPLICATION_CREDENTIALS=/home/your-username/882-202609-class-project/sa-key.json
